роев и подконтрольных крипов, где бы они не находились. Сперва применяется сильное лечение, а затем 10 сек. действует периодическое.","desc_en":"Heals all allied heroes on the map as well as all units under Chen's control. A large heal is applied at first and a slow heal over time is applied for 10 seconds afterwards.","notes_ru":["Лечит неуязвимых и скрытых/изгнанных союзников."],"notes_en":["Can heal invulnerable and hidden/banished allies."],"specials":[{"key":"heal_amount","system":false,"heading_ru":"НАЧАЛЬНОЕ ЛЕЧЕНИЕ:","heading_en":"INITIAL HEAL:","values":[200.0,300.0,400.0],"percent":false},{"key":"hot_duration","system":false,"heading_ru":null,"heading_en":null,"values":[10.0],"percent":false},{"key":"heal_per_second","system":false,"heading_ru":"ЛЕЧЕНИЕ В СЕКУНДУ:","heading_en":"HEAL PER SECOND:","values":[20.0,30.0,40.0],"percent":false},{"key":"ancient_creeps_scepter","system":false,"heading_ru":"МАКСИМУМ ДРЕВНИХ КРИПОВ С AGHANIM'S SHARD:","heading_en":"SHARD HOLY PERSUASION ANCIENTS:","values":[0.0],"percent":false,"values_shard":[1.0,2.0,3.0]},{"key":"does_purge","system":false,"heading_ru":null,"heading_en":null,"values":[],"percent":false,"talents":[{"talent":"special_bonus_unique_chen_12","level":25,"op":"add","value":1}]},{"key":"full_heal_on_chen_and_creeps","system":false,"heading_ru":null,"heading_en":null,"values":[],"percent":false,"talents":[{"talent":"special_bonus_unique_chen_2","level":25,"op":"set","value":1}]},{"key":"debuff_immune_radius","system":false,"heading_ru":"РАДИУС ЭФФЕКТА:","heading_en":"CHANNEL RADIUS:","values":[0.0],"percent":false,"values_scepter":[800.0]},{"key":"debuff_immune_resist","system":false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"values_scepter":[60.0]},{"key":"nearby_hot_boost","system":false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"values_scepter":[200.0]},{"key":"AbilityChannelTime","system":true,"heading_ru":null,"heading_en":null,"values":[0.0],"percent"