ed_attack_damage_pct","system":false,"heading_ru":"УРОН В СЕКУНДУ:","heading_en":"DAMAGE PER SECOND:","values":[3.0,6.0,9.0,12.0],"percent":true,"talents":[{"talent":"special_bonus_unique_kez_kazura_katana_bleed_damage","level":20,"op":"add","value":3.5,"values_with":[6.5,9.5,12.5,15.5]}]},{"key":"impale_duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ ПРОНЗАНИЯ:","heading_en":"IMPALE DURATION:","values":[0.5],"percent":false},{"key":"bleed_as_rupture_pct","system":false,"heading_ru":"ДОЛЯ АКТИВИРУЕМЫХ ПРОНЗАНИЕМ ЭФФЕКТОВ:","heading_en":"STACKS AS BURST DAMAGE:","values":[50.0],"percent":true,"values_shard":[50.0]},{"key":"lifesteal_pct","system":false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"values_shard":[100.0]},{"key":"creep_lifesteal_reduction_pct","system":false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"values_shard":[40.0]},{"key":"max_stacks","system":false,"heading_ru":"МАКС. УРОН ОТ ПРОНЗАНИЯ:","heading_en":"MAX BURST STACKS:","values":[500.0],"percent":false,"values_shard":[500.0]},{"key":"backstab_angle","system":false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"values_shard":[105.0]},{"key":"AbilityCastRange","system":true,"heading_ru":null,"heading_en":null,"values":[200.0],"percent":false},{"key":"AbilityManaCost","system":true,"heading_ru":null,"heading_en":null,"values":[40.0],"percent":false},{"key":"AbilityCooldown","system":true,"heading_ru":null,"heading_en":null,"values":[24.0,18.0,12.0,6.0],"percent":false}],"shard":{"text_ru":"Добавляет 100% вампиризма при пронзании и увеличивает его максимальный урон. Если цель повёрнута спиной, способность оглушит её и мгновенно нанесёт весь отложенный урон.","text_en":"Kez lifesteals 100% from the impale. If the impale comes from behind the target, the target is stunned. Increases max burst stacks.","changes":[{"key":"lifesteal_pct","heading_ru":null,"from":[0.0],"to":[100.0]},{"key":"creep_lifesteal_reduction_pct","heading_ru":null,"from":[0.0],"to":[40.0]},{"key":"backstab_angle","heading_ru":null,"from":[0.0],"to":[105.0]}]},"scepter":null},{"key":"kez_switch_weapons","id":1497,"hero":"kez","name_ru":"Switch Discipline","name_en":"Switch Discipline","kind":"basic","innate":true,"granted_by_scepter":false,"granted_by_shard":false,"max_level":1,"behavior":["no_target","immediate","ignore_backswing","ignore_silence","bit46"],"behavior_ru":["без цели","мгновенная","игнорирует silence"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":null,"bkb_pierce":null,"immunity_code":0,"immunity":"none","dispellable":null,"cooldown":[8.0],"mana_cost":[],"health_cost":[],"gold_cost":[],"cast_range":[],"cast_point":[],"channel_time":[],"duration":[],"desc_ru":"Герой меняет боевой стиль, переключаясь между катаной казураев и саями Шодо.\nУ каждого стиля свои способности и характеристики атаки. Способности, занимающие одну и ту же ячейку, имеют общие уровни и перезарядки для обоих стилей.\nПереключившись на катану, герой нанесёт больше урона следующей атакой или способностью, а взявшись за саи — ненадолго повысит свою скорость.","desc_en":"Kez switches between his Kazurai Katana and Shodo Sai.\nHe gains different attack capabilities and abilities based on the weapon equipped. The abilities level up together, and when an ability is used, the associated alternate weapon ability also goes on cooldown.\nKez deals extra damage on the first Katana hit or ability after switching to Katana, and gains bonus speed after switching to Sai.","notes_ru":[],"notes_en":[],"specials":[{"key":"katana_attack_range","system":false,"heading_ru":"ДАЛЬНОСТЬ АТАКИ (КАТАНА):","heading_en":"KATANA ATTACK RANGE:","values":[225.0],"percent":false},{"key":"katana_base_attack_time","system":false,"heading_ru":"БАЗОВЫЙ ИНТЕРВАЛ АТАК (КАТАНА):","heading_en":"KATANA BASE ATTACK TIME:","values":[1.9],"percent":false},{"key":"katana_agility_bonus_base_damage","system":false,"heading_ru":"ДОП. УРОН ОТ ЛОВКОСТИ (КАТАНА):","h