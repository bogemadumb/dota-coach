орону своего взгляда. Если применить эту способность на область, герой ударит ближайшую цель в радиусе 200 (наивысший приоритет — у каменных копий). Оттолкнутый объект наносит урон всем врагам, по которым попадает. Каменные копии летят дальше и замедляют всех жертв на своём пути.","desc_en":"Earth Spirit smashes the target enemy or ally, sending them in the direction he is facing. If Earth Spirit targets an area, he will smash the nearest unit in a 200 radius, prioritizing Stone Remnants. The travelling unit or Remnant damages all enemy units it hits. If an enemy is hit by a Stone Remnant, they are also slowed. Stone Remnants travel further than other units.","notes_ru":[],"notes_en":[],"specials":[{"key":"radius","system":false,"heading_ru":null,"heading_en":null,"values":[180.0],"percent":false},{"key":"rock_search_aoe","system":false,"heading_ru":"РАДИУС ПОИСКА КОПИИ:","heading_en":"REMNANT SMASH RADIUS:","values":[200.0],"percent":false},{"key":"rock_damage","system":false,"heading_ru":"УРОН:","heading_en":"DAMAGE:","values":[110.0,180.0,250.0,320.0],"percent":false,"talents":[{"talent":"special_bonus_unique_earth_spirit_6","level":15,"op":"add","value":80,"values_with":[190.0,260.0,330.0,400.0]}]},{"key":"move_slow","system":false,"heading_ru":"ЗАМЕДЛЕНИЕ:","heading_en":"SLOW AMOUNT:","values":[50.0],"percent":true},{"key":"duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ ЗАМЕДЛЕНИЯ:","heading_en":"SLOW DURATION:","values":[1.75,2.5,3.25,4.0],"percent":false},{"key":"speed","system":false,"heading_ru":"СКОРОСТЬ ПОЛЁТА:","heading_en":"TRAVEL SPEED:","values":[900.0],"percent":false},{"key":"unit_distance","system":false,"heading_ru":"ДАЛЬНОСТЬ ПОЛЁТА СУЩЕСТВА:","heading_en":"DISTANCE:","values":[500.0,600.0,700.0,800.0],"percent":false},{"key":"rock_distance","system":false,"heading_ru":"ДАЛЬНОСТЬ ПОЛЁТА КОПИИ:","heading_en":"DISTANCE (REMNANT):","values":[2000.0],"percent":false},{"key":"remnant_smash_radius_tooltip","system":false,"heading_ru":null,"heading_en":null,"values":[200.0],"percent":false},{"key":"creep_multiplier","system":false,"heading_ru":null,"heading_en":null,"values":[1.0],"percent":false},{"key":"AbilityCastRange","system":true,"heading_ru":null,"heading_en":null,"values":[150.0],"percent":false},{"key":"AbilityManaCost","system":true,"heading_ru":null,"heading_en":null,"values":[100.0],"percent":false},{"key":"AbilityCooldown","system":true,"heading_ru":null,"heading_en":null,"values":[20.0,17.0,14.0,11.0],"percent":false,"talents":[{"talent":"special_bonus_unique_earth_spirit_7","level":10,"op":"subtract","value":2,"values_with":[18.0,15.0,12.0,9.0]}]}],"shard":null,"scepter":null},{"key":"earth_spirit_rolling_boulder","id":5609,"hero":"earth_spirit","name_ru":"Rolling Boulder","name_en":"Rolling Boulder","kind":"basic","innate":false,"granted_by_scepter":false,"granted_by_shard":false,"max_level":4,"behavior":["point","root_disables","ignore_backswing"],"behavior_ru":["в точку","блокируется корнями"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":"magical","bkb_pierce":false,"immunity_code":4,"immunity":"enemies_no","dispellable":"strong","cooldown":[16.0,12.0,8.0,4.0],"mana_cost":[50.0],"health_cost":[],"gold_cost":[],"cast_range":[3000.0],"cast_point":[],"channel_time":[],"duration":[],"desc_ru":"Герой сворачивается в валун, который после задержки в 0.6 сек. катится в выбранном направлении, оглушает врагов и наносит им урон в размере 60/70/80/90 + 100% от силы. Он остановится, если попадёт во вражеского героя или будет оглушён. Валун станет сильнее, если попадёт на каменную копию: он покатится быстрее и дальше, а оглушение от него будет дольше.","desc_en":"Earth Spirit gathers himself into a boulder and, after a 0.6s delay, rolls toward the target location, dealing 60/70/80/90 + 100% STR damage and stunning enemy units. He will stop if he collides with an enemy hero or is stunned. If he rolls over a Stone Remnant, he will travel further and faster, and stun enemies for longer.","notes_ru":["Если валун попадёт на каменную копию, она будет уничтожена.","Радиус валуна — 160.","В валуне герой неуязвим, и его нельзя выбрать целью."],"notes_en":["Rolling over a Stone Remnant will destroy the Remnant.","The boulder has a radius of 160.","Earth Spirit is untargetable and invulnerable while rolling."],"specials":[{"key":"radius","system":false,"heading_ru":null,"heading_en":null,"values":[160.0],"percent":false},{"key":"speed","system":false,"heading_ru":"СКОРОСТЬ:","heading_en":"SPEED:","values":[1000.0],"percent":false},{"key":"rock_speed","system":false,"heading_ru":"СКОРОСТЬ С КОПИЕЙ:","heading_en":"SPEED (REMNANT):","values":[1600.0],"percent":false},{"key":"distance","system":false,"heading_ru":"ДАЛЬНОСТЬ:","heading_en":"DISTANCE:","values":[800.0],"percent":false,"talents":[{"talent":"special_bonus_unique_earth_spirit_4","level":10,"op":"add","value":150,"values_with":[950.0]}]},{"key":"rock_distance_multiplier","system":false,"heading_ru":"МНОЖИТЕЛЬ ДАЛЬНОСТИ С КОПИЕЙ:","heading_en":"DISTANCE MULTIPLIER (REMNANT):","values":[2.0],"percent":false},{"key":"delay","system":false,"heading_ru":null,"heading_en":null,"values":[0.6],"percent":false},{"key":"damage","system":false,"heading_ru":"УРОН:","heading_en":"DAMAGE:","values":[60.0,70.0,80.0,90.0],"percent":false},{"key":"stun_duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ ОГЛУШЕНИЯ:","heading_en":"STUN DURATION:","values":[0.3,0.5,0.7,0.9],"percent":false,"talents":[{"talent":"special_bonus_unique_earth_spirit_rolling_boulder_stun","level":15,"op":"add","value":0.3,"values_with":[0.6,0.8,1.0,1.2]}]},{"key":"rock_bonus_duration","system":false,"heading_ru":"ДОП. ОГЛУШЕНИЕ С КОПИЕЙ:","heading_en":"ROCK BONUS STUN DURATION:","values":[0.3,0.5,0.7,0.9],"percent":false},{"key":"damage_str","system":false,"heading_ru":null,"heading_en":null,"values":[100.0],"percent":false,"talents":[{"talent":"special_bonus_unique_earth_spirit","level":25,"op":"add","value":250,"values_with":[350.0]}]},{"