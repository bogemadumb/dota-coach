m":[600.0],"to":[50.0]},{"key":"cast_range_heroes","heading_ru":"ДАЛЬНОСТЬ ПРИМЕНЕНИЯ НА СОЮЗНИКОВ:","from":[550.0,600.0,650.0,700.0],"to":[50.0]},{"key":"AbilityCooldown","heading_ru":null,"from":[13.0],"to":[3.0]}]},"scepter":null},{"key":"earth_spirit_stone_caller","id":1395,"hero":"earth_spirit","name_ru":"Stone Remnant","name_en":"Stone Remnant","kind":"basic","innate":true,"granted_by_scepter":false,"granted_by_shard":false,"max_level":1,"behavior":["point","not_learnable","ignore_backswing","show_in_guides"],"behavior_ru":["в точку"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":null,"bkb_pierce":null,"immunity_code":0,"immunity":"none","dispellable":null,"cooldown":[],"mana_cost":[],"health_cost":[],"gold_cost":[],"cast_range":[1100.0],"cast_point":[],"channel_time":[],"duration":[],"desc_ru":"Создаёт свою каменную копию в указанном месте, расходуя один заряд способности, которые постепенно восстанавливаются. Копии неуязвимы, не раскрывают туман войны и используются для других способностей героя. Способность имеет 7 зарядов.\nКаждый неиспользованный заряд пассивно увеличивает урон от атак владельца на 3%. Использование копии какой-либо способностью даст временный и не складывающийся бонус к урону от атак в размере 7.5% на 10 сек.","desc_en":"Call a Stone Remnant to the target location. Stone Remnants have no vision and are invulnerable, and can be used with Earth Spirit's abilities. Calling a Stone Remnant consumes a charge, which recharge over time. Stone Remnant has 7 charges.\nEarth Spirit passively gains 3% bonus damage per unused Stone Remnant charge, and gains an additional 7.5% bonus damage for 10s when a Stone Remnant is targeted with an ability (does not stack).","notes_ru":[],"notes_en":[],"specials":[{"key":"duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ:","heading_en":"DURATION:","values":[60.0],"percent":false},{"key":"rolling_offset_distance","system":false,"heading_ru":null,"heading_en":null,"values":[150.0],"percent":false},{"key":"attack_damage_per_stone","system":false,"heading_ru":null,"heading_en":null,"values":[3.0],"percent":false},{"key":"attack_damage_per_stone_used","system":false,"heading_ru":null,"heading_en":null,"values":[7.5],"percent":false},{"key":"buff_duration","system":false,"heading_ru":null,"heading_en":null,"values":[10.0],"percent":false},{"key":"AbilityCastRange","system":true,"heading_ru":null,"heading_en":null,"values":[1100.0],"percent":false},{"key":"AbilityCharges","system":true,"heading_ru":"ЧИСЛО ЗАРЯДОВ:","heading_en":"CHARGES:","values":[7.0],"percent":false},{"key":"AbilityChargeRestoreTime","system":true,"heading_ru":null,"heading_en":null,"values":[18.0],"percent":false}],"shard":null,"scepter":null},{"key":"earth_spirit_petrify","id":5648,"hero":"earth_spirit","name_ru":"Enchant Remnant","name_en":"Enchant Remnant","kind":"basic","innate":false,"granted_by_scepter":true,"granted_by_shard":false,"max_level":1,"behavior":["hidden","unit_target","show_in_guides"],"behavior_ru":["скрытая","на цель"],"target_team":["custom"],"target_type":["custom"],"target_flags":["invulnerable"],"damage_type":"magical","bkb_pierce":false,"immunity_code":4,"immunity":"enemies_no","dispellable":"no","cooldown":[45.0],"mana_cost":[150.0],"health_cost":[],"gold_cost":[],"cast_range":[175.0],"cast_point":[0.2],"channel_time":[],"duration":[],"desc_ru":"Заколдовывает выбранного героя, делая из него каменную копию. Через некоторое время копия раскалывается, выпуская цель и нанося урон противникам поблизости.\nМожно применять на каменные копии с перезарядкой в 5 секунд.\nДальность применения на союзника больше, чем на врага.","desc_en":"Earth Spirit temporarily enchants a hero, granting them the properties of a Stone Remnant. After a short duration the remnant shatters, releasing the hero and damaging nearby enemies.\nCan be cast on Stone Remnants. Has a 5 second cooldown when used that way.\nHas a larger cast range when cast on an ally hero.","notes_ru":["Эту способнос