heading_ru":null,"heading_en":null,"values":[0.1],"percent":false},{"key":"AbilityManaCost","system":true,"heading_ru":null,"heading_en":null,"values":[110.0],"percent":false},{"key":"AbilityCooldown","system":true,"heading_ru":null,"heading_en":null,"values":[17.0,15.0,13.0,11.0],"percent":false,"talents":[{"talent":"special_bonus_unique_dawnbreaker_fire_wreath_cooldown","level":25,"op":"subtract","value":4,"values_with":[13.0,11.0,9.0,7.0]}]}],"shard":{"text_ru":"На время применения даёт невосприимчивость к эффектам, +50% к сопротивлению магии и возможность передвигаться с уменьшенной на 35% скоростью (но не ниже 215).","text_en":"Dawnbreaker gains debuff immunity with 50% magic resistance and free movement during Starbreaker. Dawnbreaker is slowed by 35% down to a minimum of 215.","changes":[{"key":"shard_movement_penalty","heading_ru":null,"from":[0.0],"to":[35.0]},{"key":"immunity_resist","heading_ru":null,"from":[0.0],"to":[50.0]}]},"scepter":null},{"key":"dawnbreaker_celestial_hammer","id":7914,"hero":"dawnbreaker","name_ru":"Celestial Hammer","name_en":"Celestial Hammer","kind":"basic","innate":false,"granted_by_scepter":false,"granted_by_shard":false,"max_level":4,"behavior":["point"],"behavior_ru":["в точку"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":"magical","bkb_pierce":false,"immunity_code":4,"immunity":"enemies_no","dispellable":"basic","cooldown":[18.0,16.0,14.0,12.0],"mana_cost":[100.0,110.0,120.0,130.0],"health_cost":[],"gold_cost":[],"cast_range":[],"cast_point":[0.2],"channel_time":[],"duration":[],"desc_ru":"Герой бросает свой молот в цель, нанося урон всем врагам на пути. Молот застывает на месте на 2 сек., а затем возвращается, оставляя за собой замедляющий огненный след. Герой может воззвать к своему молоту и раньше, чтобы полететь ему навстречу и встретиться посередине.","desc_en":"Dawnbreaker hurls her weapon at a target, damaging enemies struck along the way. The hammer pauses for 2 seconds at the destination before flying back to her, leaving a trail of fire that slows enemies. Dawnbreaker can recall the hammer at any time, pulling her towards it so they meet in the middle.","notes_ru":["Молот наносит урон врагам как при броске, так и при полёте обратно.","Дальность полёта героя не может превысить дальность применения этой способности.","Способность Starbreaker нельзя применить, если молот не у героя в руках."],"notes_en":["The hammer damages enemies both when thrown and when returning to Dawnbreaker.","Dawnbreaker's Converge movement distance is capped at the ability's cast range.","Starbreaker cannot be cast while the Hammer is out."],"specials":[{"key":"hammer_damage","system":false,"heading_ru":"УРОН МОЛОТА:","heading_en":"HAMMER DAMAGE:","values":[50.0,80.0,110.0,140.0],"percent":false,"talents":[{"talent":"special_bonus_unique_dawnbreaker_celestial_hammer_damage","level":15,"op":"percent_increase","value":40,"values_with":[70.0,112.0,154.0,196.0]}]},{"key":"projectile_radius","system":false,"heading_ru":null,"heading_en":null,"values":[200.0],"percent":false},{"key":"projectile_speed","system":false,"heading_ru":null,"heading_en":null,"values":[1600.0],"percent":false,"talents":[{"talent":"special_bonus_unique_dawnbreaker_celestial_hammer_cast_range","level":25,"op":"percent_increase","value":80,"values_with":[2880.0]}]},{"key":"flare_debuff_duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ ОГНЕННОГО СЛЕДА:","heading_en":"FIRE TRAIL DURATION:","values":[2.5,3.0,3.5,4.0],"percent":false},{"key":"flare_radius","system":false,"heading_ru":"РАДИУС ОГНЕННОГО СЛЕДА:","heading_en":"FIRE TRAIL RADIUS:","values":[200.0],"percent":false},{"key":"move_slow","system":false,"heading_ru":"ЗАМЕДЛЕНИЕ ПЕРЕДВИЖЕНИЯ ОТ ОГНЕННОГО СЛЕДА:","heading_en":"FIRE TRAIL MOVEMENT SLOW:","values":[24.0,28.0,32.0,36.0],"percent":true},{"key":"targets_allies","system":false,"heading_ru":null,"heading_en":null,"values":[],"percent":false,"talents":[{"talent":"special_bonus_unique_dawnbreaker_celesti