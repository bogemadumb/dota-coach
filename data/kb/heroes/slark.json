_bonus_unique_slark_4","level":20,"op":"add","value":20,"values_with":[30.0]}]},{"key":"steal_radius","system":false,"heading_ru":"РАДИУС КРАЖИ:","heading_en":"STEAL RADIUS:","values":[300.0],"percent":false}],"shard":null,"scepter":null},{"key":"slark_shadow_dance","id":5497,"hero":"slark","name_ru":"Shadow Dance","name_en":"Shadow Dance","kind":"ultimate","innate":false,"granted_by_scepter":false,"granted_by_shard":false,"max_level":3,"behavior":["no_target","immediate"],"behavior_ru":["без цели","мгновенная"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":null,"bkb_pierce":null,"immunity_code":0,"immunity":"none","dispellable":"no","cooldown":[50.0,40.0,30.0],"mana_cost":[100.0],"health_cost":[],"gold_cost":[],"cast_range":[],"cast_point":[],"channel_time":[],"duration":[],"desc_ru":"Пассивно ускоряет передвижение и восстановление здоровья владельца, когда его не видят враги. Этот эффект пропадёт на 2 сек., если получить урон от нейтрального существа.\nМожно активировать, чтобы скрыться в облаке теней. Эту невидимость нельзя раскрыть, и она не снимается при совершении атак, использовании предметов и применении способностей, однако враги видят само облако.","desc_en":"When not visible to the enemy team, Slark passively gains bonus movement speed and health regeneration. If Slark is damaged by a neutral unit, the passive movement and health regeneration bonuses are lost for 2 seconds.\nWhen activated, Slark hides himself in a cloud of shadows, becoming immune to detection. Attacking, casting spells, and using items will not reveal Slark, but enemies can see the cloud itself.","notes_ru":[],"notes_en":[],"specials":[{"key":"bonus_movement_speed","system":false,"heading_ru":"ДОП. СКОРОСТЬ ПЕРЕДВИЖЕНИЯ:","heading_en":"BONUS MOVEMENT SPEED:","values":[20.0,30.0,40.0],"percent":true},{"key":"bonus_regen","system":false,"heading_ru":"ВОССТАНОВЛЕНИЕ ЗДОРОВЬЯ В СЕКУНДУ:","heading_en":"HEALTH GAINED PER SECOND:","values":[60.0,90.0,120.0],"percent":false,