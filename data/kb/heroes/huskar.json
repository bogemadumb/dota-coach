ck range.","text_en":"Burning Spears launches an additional [?] spears onto random enemies within Huskar's attack range.","changes":[]}},{"key":"huskar_berserkers_blood","id":5273,"hero":"huskar","name_ru":"Berserker's Blood","name_en":"Berserker's Blood","kind":"basic","innate":false,"granted_by_scepter":false,"granted_by_shard":false,"max_level":4,"behavior":["passive"],"behavior_ru":["пассивная"],"target_team":["friendly"],"target_type":["hero"],"target_flags":[],"damage_type":null,"bkb_pierce":null,"immunity_code":0,"immunity":"none","dispellable":null,"cooldown":[],"mana_cost":[],"health_cost":[],"gold_cost":[],"cast_range":[],"cast_point":[],"channel_time":[],"duration":[],"desc_ru":"Раны делают героя сильнее, увеличивая его скорость атаки, сопротивление магии и восстановление здоровья в зависимости от доли недостающего здоровья. Восстановление равно доле от силы героя.","desc_en":"Huskar's injuries feed his power, giving increased attack speed, magic resistance and health regen based on missing health. Health regen is a percentage of your strength.","notes_ru":["Бонусы даются линейно: они отсутствуют при полном здоровье, а в полную силу действуют при менее чем 10% здоровья."],"notes_en":["Bonuses are provided linearly, no bonus at Full HP and full bonus at strictly less than 10% HP."],"specials":[{"key":"maximum_attack_speed","system":false,"heading_ru":"МАКС. СКОРОСТЬ АТАКИ:","heading_en":"MAX ATTACK SPEED:","values":[170.0,220.0,270.0,320.0],"percent":false},{"key":"maximum_health_regen","system":false,"heading_ru":"МАКС. ВОССТАНОВЛЕНИЕ ОТ СИЛЫ:","heading_en":"MAX STR REGEN:","values":[25.0,40.0,55.0,70.0],"percent":true,"talents":[{"talent":"special_bonus_unique_huskar_6","level":20,"op":"add","value":30,"values_with":[55.0,70.0,85.0,100.0]}]},{"key":"maximum_magic_resist","system":false,"heading_ru":"МАКС. СОПРОТИВЛЕНИЕ МАГИИ:","heading_en":"MAX MAGIC RESIST:","values":[15.0,20.0,25.0,30.0],"percent":true},{"key":"hp_threshold_max","system":false,"heading