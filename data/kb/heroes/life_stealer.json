.0],"percent":false},{"key":"damage","system":false,"heading_ru":"УРОН:","heading_en":"DAMAGE:","values":[150.0,275.0,400.0],"percent":false,"talents":[{"talent":"special_bonus_unique_lifestealer_infest_damage","level":15,"op":"add","value":175,"values_with":[325.0,450.0,575.0]}]},{"key":"bonus_movement_speed","system":false,"heading_ru":"ДОП. СКОРОСТЬ ПЕРЕДВИЖЕНИЯ:","heading_en":"MOVEMENT SPEED:","values":[15.0,20.0,25.0],"percent":true,"talents":[{"talent":"special_bonus_unique_lifestealer_infest_target_bonus","level":20,"op":"add","value":12,"values_with":[27.0,32.0,37.0]}]},{"key":"bonus_health","system":false,"heading_ru":"ДОП. ЗДОРОВЬЕ:","heading_en":"HEALTH BONUS:","values":[400.0,800.0,1200.0],"percent":false,"talents":[{"talent":"special_bonus_unique_lifestealer_infest_target_bonus","level":20,"op":"percent_increase","value":15,"values_with":[460.0,920.0,1380.0]}]},{"key":"self_regen","system":false,"heading_ru":"ЛЕЧЕНИЕ ОТ МАКС. ЗДОРОВЬЯ:","heading_en":"SELF MAX HP REGEN:","values":[3.0,4.0,5.0],"percent":true,"values_scepter":[100.0]},{"key":"infest_duration_enemy","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ НА ВРАГАХ:","heading_en":"ENEMY DURATION:","values":[0.0],"percent":false,"values_scepter":[4.0]},{"key":"attack_rate_enemy","system":false,"heading_ru":"ИНТЕРВАЛ АТАК:","heading_en":"ATTACK RATE:","values":[0.0],"percent":false,"values_scepter":[1.0]},{"key":"creep_max_hp_drain_pct_per_second","system":false,"heading_ru":"ПОТЕРЯ МАКС. ЗДОРОВЬЯ КРИПА В СЕК.:","heading_en":"CREEP MAX HP LOSS / SEC:","values":[1.5,0.75,0.0],"percent":true},{"key":"can_target_ancients","system":false,"heading_ru":null,"heading_en":null,"values":[1.0],"percent":false},{"key":"dot_damage_as_pct_of_damage_dealt","system":false,"heading_ru":"СУММАРНЫЙ УРОН ОТ ОСТАВШЕГОСЯ ЗДОРОВЬЯ:","heading_en":"REMAINING HEALTH AS TOTAL DAMAGE:","values":[0.0],"percent":true,"values_shard":[30.0]},{"key":"dot_duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ ПЕРИОДИЧЕСКОГО УРОНА:","heading_