:false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"legacy_facet":{"facet":"dazzle_facet_nothl_boon","values":[2.0],"op":5}},{"key":"enemy_multiplier","system":false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"legacy_facet":{"facet":"dazzle_poison_bloom","values":[2.0],"op":5}},{"key":"ally_heal","system":false,"heading_ru":null,"heading_en":null,"values":[0.0],"percent":false,"values_shard":[60.0]}],"shard":{"text_ru":"Срабатывание на союзников излечивает их на 60 за каждый эффект этой способности.","text_en":"Applying Weave to an ally heals them for 60 per stack of Weave.","changes":[{"key":"ally_heal","heading_ru":null,"from":[0.0],"to":[60.0]}]},"scepter":null},{"key":"dazzle_nothl_projection","id":1550,"hero":"dazzle","name_ru":"Nothl Projection","name_en":"Nothl Projection","kind":"ultimate","innate":false,"granted_by_scepter":false,"granted_by_shard":false,"max_level":3,"behavior":["point"],"behavior_ru":["в точку"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":null,"bkb_pierce":null,"immunity_code":0,"immunity":"none","dispellable":"no","cooldown":[70.0,60.0,50.0],"mana_cost":[100.0,150.0,200.0],"health_cost":[],"gold_cost":[],"cast_range":[450.0],"cast_point":[0.2],"channel_time":[],"duration":[],"desc_ru":"Герой отделяет свою душу от тела и направляет её в мир Нотл. Душа неуязвима и может как совершать атаки, так и применять способности и предметы, а между ней и телом возникает видимая связь. В мире Нотл все базовые способности героя усилены: Poison Touch накладывает проклятие, превращающее врагов в зверушек, Shallow Grave лечит цель по окончании её бессмертия, а Shadow Wave перезаряжается быстрее. Герой вернётся в своё тело, если прервёт способность сам или если её действие закончится.","desc_en":"Dazzle departs his body, traveling through the Nothl Realm as an invulnerable spirit that can cast spells, attack, and use items, leaving his body behind in the world with a visible tether. While active, Dazzle's basic abilities are empowered: Poison Touch hexes enemies, Shallow Grave heals upon expiration, and Shadow Wave has a shorter cooldown. The effect can be ended early, and Dazzle returns to the body at the end.","notes_ru":["Когда душа удаляется от тела на расстояние более 1600, связь начинает притягивать её к телу: чем оно дальше, тем сильнее притяжение.","Душа не может атаковать постройки."],"notes_en":["When Dazzle's spirit is further than 1600 units from the body, the tether will begin to pull him back. The strength of the pull increases with distance.","Dazzle's Soul cannot attack buildings."],"specials":[{"key":"min_duration","system":false,"heading_ru":"МИН. ДЛИТЕЛЬНОСТЬ:","heading_en":"MIN DURATION:","values":[5.0],"percent":false},{"key":"max_duration","system":false,"heading_ru":"МАКС. ДЛИТЕЛЬНОСТЬ:","heading_en":"MAX DURATION:","values":[12.0],"percent":false,"talents":[{"talent":"special_bonus_unique_dazzle_nothl_projection_duration","level":15,"op":"add","value":5,"values_with":[17.0]}]},{"key":"initial_travel_speed","system":false,"heading_ru":null,"heading_en":null,"values":[1200.0],"percent":false},{"key":"soul_return_time","system":false,"heading_ru":null,"heading_en":null,"values":[0.75],"percent":false},{"key":"soul_return_min_speed","system":false,"heading_ru":null,"heading_en":null,"values":[500.0],"percent":false},{"key":"leash_start","system":false,"heading_ru":null,"heading_en":null,"values":[1600.0],"percent":false},{"key":"base_leash_pull","system":false,"heading_ru":null,"heading_en":null,"values":[50.0],"percent":false},{"key":"leash_increase","system":false,"heading_ru":null,"heading_en":null,"values":[1.5],"percent":false},{"key":"poison_touch_hex","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ ПРОКЛЯТИЯ:","heading_en":"HEX DURATION:","values":[1.4,1.6,1.8],"percent":false},{"key":"shallow_grave_heal","system":false,"heading_ru":"ЛЕЧЕНИЕ ПОСЛЕ SHALLOW GRAVE:","heading_en":"SHALLOW GRAVE HEAL:","values":[225.0,300.0,375.0],"p