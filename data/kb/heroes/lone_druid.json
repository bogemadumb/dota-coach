":[0.0]},{"key":"root_heroes_on_cast","heading_ru":null,"from":[0.0],"to":[1.0]}]}},{"key":"lone_druid_spirit_link","id":7309,"hero":"lone_druid","name_ru":"Spirit Link","name_en":"Spirit Link","kind":"basic","innate":false,"granted_by_scepter":false,"granted_by_shard":false,"max_level":4,"behavior":["passive"],"behavior_ru":["пассивная"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":null,"bkb_pierce":null,"immunity_code":0,"immunity":"none","dispellable":null,"cooldown":[],"mana_cost":[],"health_cost":[],"gold_cost":[],"cast_range":[],"cast_point":[],"channel_time":[],"duration":[],"desc_ru":"Связывает духа-медведя с владельцем, отчего скорость передвижения обоих увеличивается, а урон, наносимый атаками одного, восстанавливает здоровье другому.","desc_en":"Links Lone Druid and the Spirit Bear, increasing their movement speed as well as sharing a percentage of their lifesteal with each other.","notes_ru":["Общий вампиризм отключается истощением."],"notes_en":["Break disables the shared lifesteal."],"specials":[{"key":"bonus_movement_speed_druid","system":false,"heading_ru":"ДОП. СКОРОСТЬ ПЕРЕДВИЖЕНИЯ (ГЕРОЮ):","heading_en":"MOVEMENT SPEED (LONE DRUID):","values":[10.0,20.0,30.0,40.0],"percent":false},{"key":"bonus_movement_speed_bear","system":false,"heading_ru":"ДОП. СКОРОСТЬ ПЕРЕДВИЖЕНИЯ (МЕДВЕДЮ):","heading_en":"MOVEMENT SPEED (SPIRIT BEAR):","values":[20.0,40.0,60.0,80.0],"percent":false},{"key":"lifesteal_percent","system":false,"heading_ru":"ОБЩИЙ ВАМПИРИЗМ:","heading_en":"SHARED LIFESTEAL:","values":[15.0,30.0,45.0,60.0],"percent":true},{"key":"creep_lifesteal_penalty","system":false,"heading_ru":null,"heading_en":null,"values":[40.0],"percent":false},{"key":"lifesteal_both_ways","system":false,"heading_ru":null,"heading_en":null,"values":[1.0],"percent":false},{"key":"duration","system":false,"heading_ru":null,"heading_en":null,"values":[20.0],"percent":false},{"key":"active_bonus","system":false,"heading_ru":null,"heading_en":null,"values":[35.0],"percent":false}],"shard":null,"scepter":{"text_ru":"Герой разрывает связь с духом-медведем и создаёт связь с выбранным союзным героем, наделяя его бонусами от этой способности на 20 сек. Увеличивает общую броню и дополнительную скорость атаки на 35%, а урон, нанесённый одним героем, излечивает другого.\nНа время этого эффекта на духа-медведя накладывается страх, если только у него тоже нет Aghanim's Scepter.","text_en":"Lone Druid severs his link to his Spirit Bear, and connects to the target allied hero, sharing the Spirit Link bonuses with them for 20s. Armor sharing and attack speed are increased by 35%. Damage done by the ally heals Lone Druid, as well as the other way around.\nThe Spirit Bear is feared for the duration of the transformation, unless he has his own Aghanim's Scepter.","changes":[]}},{"key":"lone_druid_savage_roar","id":5414,"hero":"lone_druid","name_ru":"Savage Roar","name_en":"Savage Roar","kind":"basic","innate":false,"granted_by_scepter":false,"granted_by_shard":false,"max_level":4,"behavior":["no_target"],"behavior_ru":["без цели"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":null,"bkb_pierce":false,"immunity_code":4,"immunity":"enemies_no","dispellable":"basic","cooldown":[29.0,26.0,23.0,20.0],"mana_cost":[50.0],"health_cost":[],"gold_cost":[],"cast_range":[],"cast_point":[0.1],"channel_time":[],"duration":[],"desc_ru":"Герой и его медведь издают яростный рёв, заставляя врагов в ужасе бежать к своей базе. Скорость передвижения жертв увеличивается на 20%.","desc_en":"Lone Druid and the Spirit Bear roar fiercely causing nearby enemies to flee towards their base in terror. Their movement speed is increased by 20%.","notes_ru":["Герой, связанный корнями, убегать не сможет.","Время перезарядки общее с медведем."],"notes_en":["An entangled hero will not be able to move.","Cooldown is shared with Spirit Bear."],"specials":[{"key":"radius","system":false,"heading_ru":"ДАЛЬНОСТЬ:","heading_en":"RANGE:","values":[350.0],"percent":false,"talents":[{"talent":"special_bonus_unique_lone_druid_savage_roar_aoe","level":20,"op":"add","value":125,"values_with":[475.0]}]},{"key":"bonus_speed","system":false,"heading_ru":"ДОП. СКОРОСТЬ ПЕРЕДВИЖЕНИЯ ВРАГА:","heading_en":"ENEMY MOVEMENT SPEED BONUS:","values":[20.0],"percent":true},{"key":"duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ:","heading_en":"DURATION:","values":[1.1,1.4,1.7,2.0],"percent":false},{"key":"only_affects_player_units","system":false,"heading_ru":null,"heading_en":null,"values":[1.0],"percent":false},{"key":"shard_radius","system":false,"heading_ru":"РАДИУС:","heading_en":"RADIUS:","values":[0.0],"percent":false,"values_shard":[700.0]},{"key":"shard_movement_speed_pct","system":false,"heading_ru":"ДОП. СКОРОСТЬ ПЕРЕДВИЖЕНИЯ:","heading_en":"BONUS MOVEMENT SPEED:","values":[0.0],"percent":true,"values_shard":[10.0]},{"key":"shard_attack_speed","system":false,"heading_ru":"ДОП. СКОРОСТЬ АТАКИ:","heading_en":"BONUS ATTACK SPEED:","values":[0.0],"percent":false,"values_shard":[40.0]},{"key":"shard_duration","system":false,"heading_ru":"ДЛИТЕЛЬНОСТЬ:","heading_en":"DURATION:","values":[0.0],"percent":false,"values_shard":[4.0]},{"key":"AbilityCastPoint","system":true,"heading_ru":null,"heading_en":null,"values":[0.1],"percent":false},{"key":"AbilityManaCost","system":true,"heading_ru":null,"heading_en":null,"values":[50.0],"percent":false},{"key":"AbilityCooldown","system":true,"heading_ru":null,"heading_en":null,"values":[29.0,26.0,23.0,20.0],"percent":false,"talents":[{"talent":"special_bonus_unique_lone_druid_4","level":15,"op":"subtract","value":4,"values_with":[25.0,22.0,19.0,16.0]}]}],"shard":{"text_ru":"Способность ускоряет передвижение и атаку союзников неподалёку. Применяет простое развеивание и срабатывает вокруг героя и медведя вне зависимости от их состояния.\nТИП РАЗВЕИВАНИЯ: нормальное","text_en":"Applies a basic dispel and grants allies in an area around the caster bonus movement and attack speed. Replicates between Lone Druid and Spirit Bear regardless of castability on the other.\nDISPEL TYPE: Basic Dispel","changes":[{"key":"shard_radius","heading_ru":"РАДИУС:","from":[0.0],"to":[700.0]},{"key":"shard_movement_speed_pct","heading_ru":"ДОП. СКОРОСТЬ ПЕРЕДВИЖЕНИЯ:","from":[0.0],"to":[10.0]},{"key":"shard_attack_speed","heading_ru":"ДОП. СКОРОСТЬ АТАКИ:","from":[0.0],"to":[40.0]},{"key":"shard_duration","heading_ru":"ДЛИТЕЛЬНОСТЬ:","from":[0.0],"to":[4.0]}]},"scepter":null},{"key":"lone_druid_spirit_bear","id":1342,"hero":"lone_druid","name_ru":"Summon Spirit Bear","name_en":"Summon Spirit Bear","kind":"basic","innate":true,"granted_by_scepter":false,"granted_by_shard":false,"max_level":1,"behavior":["no_target"],"behavior_ru":["без цели"],"target_team":[],"target_type":[],"target_flags":[],"damage_type":null,"bkb_pierce":null,"immunity_code":0,"immunity":"none","dispellable":null,"cooldown":[120.0],"mana_cost":[100.0],"health_cost":[],"gold_cost":[],"cast_range":[],"cast_point":[0.5],"channel_time":[],"duration":[],"desc_ru":"Призывает могучего духа-медведя, который может использовать предметы.\nМедведь не может атаковать, если расстояние до владельца превышает 1100. Если медведь погибнет, герой получит урон в размере 20% от своего максимального здоровья.\nУ медведя есть способности Demolish, Return, Entangling Claws, Savage Roar и Spirit Link.","desc_en":"Summons a powerful Spirit Bear companion that can equip items.\nIf the bear moves 1100 distance away from the Lone Druid, it cannot attack. Lone Druid suffers 20% of his max health as backlash damage if the Spirit Bear dies.\nSpirit Bear has Demolish, Return, Entangling Claws, Savage Roar, and Spirit Link abilities.","notes_ru":["Большинство заклинаний действуют на медведя так же, как на героев.","У медведя 0 базовых атрибутов, 0 базовой брони и [?]% базового сопротивления магии. Атрибуты от эффектов или предметов действуют на медведя так же, как на универсальных героев.","Медведь не может получать опыт. Его уровень повышается с каждым уровнем владельца.","У медведя есть свои улучшения от Aghanim's Scepter и Aghanim's Shard.","Медведь имеет тот же нейтральный предмет, что и его владелец, но с отдельной перезарядкой."],"notes_en":["Most spells interact with the Spirit Bear in the same way as they do with heroes.","Spirit Bear has 0 base attributes, 0 base armor, and [?]% base magic resistance. Attributes from buffs or items fully affect the bear as they would for Universal heroes.","Spirit Bear cannot gain experience. The Spirit Bear levels up when Lone Druid levels up.","Spirit Bear has its own Aghanim's Scepter and Shard upgrades.","Spirit Bear receives a copy of Lone Druid's Neutral Item that has an independent cooldown."],"specials":[{"key":"bear_hp","system":false,"heading_ru":"БАЗОВОЕ ЗДОРОВЬЕ МЕДВЕДЯ:","heading_en":"BEAR BASE HP:","values":[1500.0],"percent":false},{"key":"bear_regen_tooltip","system":false,"heading_ru":"БАЗОВОЕ ВОССТАНОВЛЕНИЕ ЗДОРОВЬЯ:","heading_en":"BEAR BASE HP REGEN:","values":[1.5],"percent":false},{"key":"bear_bat","system":false,"heading_ru":"БАЗОВЫЙ ИНТЕРВАЛ АТАК:","heading_en":"BEAR BASE ATTACK TIME:","values":[1.5],"percent":false},{"key":"bear_armor","system":false,"heading_ru":"БАЗОВАЯ БРОНЯ:","heading_en":"BEAR BASE ARMOR:","values":[-1.0],"percent":false},{"key":"backlash_damage","system":false,"heading_ru":null,"heading_en":null,"values":[20.0],"percent":false},{"key":"bear_movespeed","system":false,"heading_ru":"СКОРОСТЬ ПЕРЕДВИЖЕНИЯ:","heading_en":"BEAR MOVESPEED:","values":[310.0],"percent":false},{"key":"bear_magic_resistance","system":false,"heading_ru":null,"heading_en":null,"values":[25.0],"percent":false},{"key":"bear_attack_leash_range","system":false,"heading_ru":null,"heading_en":null,"values":[1100.0],"percent":false},{"key":"strength_gain_tooltip","system":false,"heading_ru":"ПРИРОСТ СИЛЫ:","heading_en":"BEAR STRENGTH GAIN:","values":[4.5],"percent":false},{"key":"agility_gain_tooltip","system":false,"heading_ru":"ПРИРОСТ ЛОВК