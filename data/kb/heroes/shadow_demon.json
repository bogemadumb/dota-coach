its with a poison effect. The poison deals 1/2/4/8/16 times the stack damage based on the number of stacks on the target, up to 5 stacks. Additional stacks cause 60 damage each. This deferred damage is dealt when Shadow Poison's duration is expired, or the Release sub-ability is used.","notes_ru":["Действует на существ, скрытых способностью Disruption."],"notes_en":["Shadow Poison can affect units under Disruption."],"specials":[{"key":"stack_damage","system":false,"heading_ru":"БАЗОВЫЙ УРОН ОТ ЯДА:","heading_en":"STACK DAMAGE:","values":[24.0,36.0,48.0,60.0],"percent":false,"talents":[{"talent":"special_bonus_unique_shadow_demon_4","level":10,"op":"percent_increase","value":15,"values_with":[27.6,41.4,55.2,69.0]}]},{"key":"max_multiply_stacks","system":false,"heading_ru":"МАКС. ЭФФЕКТОВ-МНОЖИТЕЛЕЙ:","heading_en":"MAX STACKS TO MULTIPLY:","values":[5.0],"percent":false},{"key":"bonus_stack_damage","system":false,"heading_ru":null,"heading_en":null,"values":[60.0],"percent":false,"talents":[{"talent":"special_bonus_unique_shadow_demon_4","level":10,"op":"percent_increase","value":15,"values_with":[69.0]}]},{"key":"radius","system":false,"heading_ru":"РАДИУС:","heading_en":"RADIUS:","values":[200.0],"percent":false},{"key":"vision_radius","system":false,"heading_ru":null,"heading_en":null,"values":[300.0],"percent":false},{"key":"speed","system":false,"heading_ru":null,"heading_en":null,"values":[1200.0],"percent":false},{"key":"hit_damage","system":false,"heading_ru":"УРОН ОТ ПОПАДАНИЯ:","heading_en":"HIT DAMAGE:","values":[24.0,36.0,48.0,60.0],"percent":false,"talents":[{"talent":"special_bonus_unique_shadow_demon_4","level":10,"op":"percent_increase","value":15,"values_with":[27.6,41.4,55.2,69.0]}]},{"key":"AbilityCastRange","system":true,"heading_ru":null,"heading_en":null,"values":[1500.0],"percent":false},{"key":"AbilityDuration","system":true,"heading_ru":"ДЛИТЕЛЬНОСТЬ ЭФФЕКТА:","heading_en":"DEBUFF DURATION:","values":[10.0],"percent":false},{"key":"AbilityCas